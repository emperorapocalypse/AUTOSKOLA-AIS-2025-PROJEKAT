@model Autoskola.DAL.Models.Instruktor

@{
    ViewData["Title"] = "Obriši Instruktora";
}

<div class="container mt-4">
    <h1 class="text-danger mb-4">Obriši Instruktora</h1>
    
    <div class="alert alert-warning" role="alert">
        <strong>Upozorenje!</strong> Da li ste sigurni da želite da obrišete ovog instruktora?
    </div>

    <div class="card">
        <div class="card-header bg-danger text-white">
            <h5 class="mb-0">Podaci instruktora</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-3 text-center">
                    @if (!string.IsNullOrEmpty(Model.ProfilnaSlika))
                    {
                        <img src="@Model.ProfilnaSlika" alt="@Model.Ime @Model.Prezime" class="img-thumbnail" style="max-width: 150px;" />
                    }
                </div>
                <div class="col-md-9">
                    <dl class="row">
                        <dt class="col-sm-4">Ime</dt>
                        <dd class="col-sm-8">@Model.Ime</dd>

                        <dt class="col-sm-4">Prezime</dt>
                        <dd class="col-sm-8">@Model.Prezime</dd>

                        <dt class="col-sm-4">JMBG</dt>
                        <dd class="col-sm-8">@Model.JMBG</dd>

                        <dt class="col-sm-4">Broj Licence</dt>
                        <dd class="col-sm-8">
                            @if (!string.IsNullOrEmpty(Model.BrojLicence))
                            {
                                @Model.BrojLicence
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Godine Iskustva</dt>
                        <dd class="col-sm-8">@Model.GodineIskustva</dd>

                        <dt class="col-sm-4">Telefon</dt>
                        <dd class="col-sm-8">
                            @if (!string.IsNullOrEmpty(Model.Telefon))
                            {
                                @Model.Telefon
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">
                            @if (!string.IsNullOrEmpty(Model.Email))
                            {
                                @Model.Email
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>

    <form asp-action="Delete" method="post" class="mt-3">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">
            Potvrdi Brisanje
        </button>
        <a asp-action="Index" class="btn btn-secondary">
            Odustani
        </a>
    </form>
</div>