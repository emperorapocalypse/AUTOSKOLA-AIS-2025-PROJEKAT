@model IEnumerable<Autoskola.DAL.Models.Ispit>
@{
    ViewData["Title"] = "Ispiti";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-clipboard-check"></i> Ispiti</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Novi Ispit
        </a>
    </div>

    @if(TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if(TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            @if(!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-clipboard-check fa-3x text-muted mb-3"></i>
                    <p class="text-muted">Trenutno nema zakazanih ispita.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Datum</th>
                                <th>Tip</th>
                                <th>Kandidat</th>
                                <th>Instruktor</th>
                                <th>Bodovi</th>
                                <th>Status</th>
                                <th>Vozila</th>
                                <th>Akcije</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                var kandidat = item.KandidatIspiti.FirstOrDefault()?.Kandidat;
                                <tr>
                                    <td>
                                        <i class="fas fa-calendar-alt text-muted me-1"></i>
                                        @item.Datum.ToString("dd.MM.yyyy")
                                    </td>
                                    <td>
                                        <span class="badge @(item.TipIspita == Autoskola.DAL.Models.TipIspita.Teorijski ? "bg-info" : "bg-warning text-dark")">
                                            @(item.TipIspita == Autoskola.DAL.Models.TipIspita.Teorijski ? "📝 Teorijski" : "🚗 Praktičan")
                                        </span>
                                    </td>
                                    <td>
                                        @if(kandidat != null)
                                        {
                                            <div class="d-flex align-items-center">
                                                @if(!string.IsNullOrEmpty(kandidat.ProfilnaSlika))
                                                {
                                                    <img src="@kandidat.ProfilnaSlika" 
                                                         alt="@kandidat.Ime" 
                                                         class="rounded-circle me-2" 
                                                         style="width: 35px; height: 35px; object-fit: cover;"
                                                         onerror="this.onerror=null; this.style.display='none'; this.nextElementSibling.style.display='inline-flex';" />
                                                    <div class="avatar-circle bg-primary text-white me-2" style="display:none;">
                                                        @kandidat.Ime.Substring(0, 1)@kandidat.Prezime.Substring(0, 1)
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="avatar-circle bg-primary text-white me-2">
                                                        @kandidat.Ime.Substring(0, 1)@kandidat.Prezime.Substring(0, 1)
                                                    </div>
                                                }
                                                <strong>@kandidat.Ime @kandidat.Prezime</strong>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                    <td>
                                        @if(item.Instruktor != null)
                                        {
                                            <div class="d-flex align-items-center">
                                                @if(!string.IsNullOrEmpty(item.Instruktor.ProfilnaSlika))
                                                {
                                                    <img src="@item.Instruktor.ProfilnaSlika" 
                                                         alt="@item.Instruktor.Ime" 
                                                         class="rounded-circle me-2" 
                                                         style="width: 35px; height: 35px; object-fit: cover;"
                                                         onerror="this.onerror=null; this.style.display='none'; this.nextElementSibling.style.display='inline-flex';" />
                                                    <div class="avatar-circle bg-success text-white me-2" style="display:none;">
                                                        @item.Instruktor.Ime.Substring(0, 1)@item.Instruktor.Prezime.Substring(0, 1)
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="avatar-circle bg-success text-white me-2">
                                                        @item.Instruktor.Ime.Substring(0, 1)@item.Instruktor.Prezime.Substring(0, 1)
                                                    </div>
                                                }
                                                <span>@item.Instruktor.Ime @item.Instruktor.Prezime</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                    <td>
                                        <strong class="@(item.Polozen ? "text-success" : "text-danger")">
                                            @item.Bodovi
                                        </strong>
                                        <span class="text-muted">/100</span>
                                    </td>
                                    <td>
                                        <span class="badge @(item.Polozen ? "bg-success" : "bg-danger")">
                                            @if(item.Polozen)
                                            {
                                                <i class="fas fa-check"></i> <text>Položen</text>
                                            }
                                            else
                                            {
                                                <i class="fas fa-times"></i> <text>Pao</text>
                                            }
                                        </span>
                                    </td>
                                    <td>
                                        @if(item.TipIspita == Autoskola.DAL.Models.TipIspita.Praktican)
                                        {
                                            <span class="badge bg-secondary">
                                                <i class="fas fa-car"></i> @item.IspitVozila.Count
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex gap-1">
                                            <a asp-action="Details" asp-route-id="@item.Id" 
                                               class="btn btn-info btn-sm text-white">
                                                Detalji
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.Id" 
                                               class="btn btn-warning btn-sm">
                                                Izmeni
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" 
                                               class="btn btn-danger btn-sm">
                                                Obriši
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .avatar-circle {
        width: 35px;
        height: 35px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 12px;
        flex-shrink: 0;
    }
    
    .table-dark {
        background-color: #2c3e50 !important;
    }
    
    .btn-sm {
        padding: 0.25rem 0.75rem;
        font-size: 0.875rem;
    }
    
    .rounded-circle {
        flex-shrink: 0;
    }
</style>