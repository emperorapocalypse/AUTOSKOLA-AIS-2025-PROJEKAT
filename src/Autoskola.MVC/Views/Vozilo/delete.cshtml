@model Autoskola.DAL.Models.Vozilo
@using Autoskola.DAL.Models

@{
    ViewData["Title"] = "Obriši Vozilo";
}

<div class="container mt-4">
    <h1 class="text-danger mb-4">Obriši Vozilo</h1>
    
    <div class="alert alert-warning" role="alert">
        <i class="bi bi-exclamation-triangle"></i>
        <strong>Upozorenje!</strong> Da li ste sigurni da želite da obrišete ovo vozilo?
        @if (Model.Slike != null && Model.Slike.Any())
{
    <br />
    <span><strong>Napomena:</strong> Biće obrisano i @Model.Slike.Count slika ovog vozila.</span>
}
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">Podaci vozila</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Marka</dt>
                        <dd class="col-sm-8">@Model.Marka</dd>

                        <dt class="col-sm-4">Model</dt>
                        <dd class="col-sm-8">@Model.Model</dd>

                        <dt class="col-sm-4">Registracija</dt>
                        <dd class="col-sm-8">@Model.Registracija</dd>

                        <dt class="col-sm-4">Godina</dt>
                        <dd class="col-sm-8">
                            @if (Model.GodinaProizvodnje.HasValue)
                            {
                                @Model.GodinaProizvodnje
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Tip Goriva</dt>
                        <dd class="col-sm-8">
                            @switch (Model.TipGoriva)
                            {
                                case TipGoriva.Benzin:
                                    <span>Benzin</span>
                                    break;
                                case TipGoriva.Dizel:
                                    <span>Dizel</span>
                                    break;
                                case TipGoriva.EV:
                                    <span>Električno</span>
                                    break;
                            }
                        </dd>

                        <dt class="col-sm-4">Vozno Stanje</dt>
                        <dd class="col-sm-8">
                            @if (Model.VoznoStanje == VoznoStanje.Vozno)
                            {
                                <span>Vozno</span>
                            }
                            else
                            {
                                <span>Nevozno</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            @if (Model.Slike != null && Model.Slike.Any())
            {
                <div class="card">
                    <div class="card-header bg-secondary text-white">
                        <h6 class="mb-0">Slike (@Model.Slike.Count)</h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            @foreach (var slika in Model.Slike.Take(4))
                            {
                                <div class="col-6 mb-2">
                                    <img src="@slika.PutanjaDoSlike" class="img-thumbnail" style="height: 80px; width: 100%; object-fit: cover;" alt="Slika vozila" />
                                </div>
                            }
                        </div>
                        @if (Model.Slike.Count > 4)
                        {
                            <p class="text-muted text-center mb-0 mt-2">+ još @(Model.Slike.Count - 4) slika</p>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <form asp-action="Delete" method="post" class="mt-3">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">
            <i class="bi bi-trash"></i> Potvrdi Brisanje
        </button>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Odustani
        </a>
    </form>
</div>