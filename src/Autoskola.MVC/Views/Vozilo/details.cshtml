@model Autoskola.DAL.Models.Vozilo
@using Autoskola.DAL.Models

@{
    ViewData["Title"] = "Detalji Vozila";
}

<div class="container mt-4">
    <h1 class="mb-4">Detalji Vozila</h1>
    <hr />

    <div class="row">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">@Model.Marka @Model.Model</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Marka</dt>
                        <dd class="col-sm-8">@Model.Marka</dd>

                        <dt class="col-sm-4">Model</dt>
                        <dd class="col-sm-8">@Model.Model</dd>

                        <dt class="col-sm-4">Registracija</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-primary fs-5">@Model.Registracija</span>
                        </dd>

                        <dt class="col-sm-4">Godina Proizvodnje</dt>
                        <dd class="col-sm-8">
                            @if (Model.GodinaProizvodnje.HasValue)
                            {
                                <span class="badge bg-info">@Model.GodinaProizvodnje</span>
                            }
                            else
                            {
                                <span class="text-muted">Nije uneto</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Tip Goriva</dt>
                        <dd class="col-sm-8">
                            @switch (Model.TipGoriva)
                            {
                                case TipGoriva.Benzin:
                                    <span class="badge bg-warning text-dark">Benzin</span>
                                    break;
                                case TipGoriva.Dizel:
                                    <span class="badge bg-dark">Dizel</span>
                                    break;
                                case TipGoriva.EV:
                                    <span class="badge bg-success">Električno</span>
                                    break;
                            }
                        </dd>

                        <dt class="col-sm-4">Vozno Stanje</dt>
                        <dd class="col-sm-8">
                            @if (Model.VoznoStanje == VoznoStanje.Vozno)
                            {
                                <span class="badge bg-success fs-6">Vozno</span>
                            }
                            else
                            {
                                <span class="badge bg-danger fs-6">Nevozno</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>

            @if (Model.GodinaProizvodnje.HasValue)
            {
                <div class="card">
                    <div class="card-header bg-info text-white">
                        <h6 class="mb-0">Dodatne Informacije</h6>
                    </div>
                    <div class="card-body">
                        <p class="mb-0">
                            Vozilo je staro <strong>@(DateTime.Now.Year - Model.GodinaProizvodnje.Value)</strong> godina.
                        </p>
                    </div>
                </div>
            }
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header bg-secondary text-white">
                    <h6 class="mb-0">Slike Vozila (@(Model.Slike?.Count ?? 0))</h6>
                </div>
                <div class="card-body">
                    @if (Model.Slike != null && Model.Slike.Any())
                    {
                        <div id="voziloCarousel" class="carousel slide" data-bs-ride="carousel">
                            <div class="carousel-indicators">
                                @for (int i = 0; i < Model.Slike.Count; i++)
                                {
                                    <button type="button" data-bs-target="#voziloCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")"></button>
                                }
                            </div>
                            <div class="carousel-inner">
                                @{
                                    int index = 0;
                                }
                                @foreach (var slika in Model.Slike)
                                {
                                    <div class="carousel-item @(index == 0 ? "active" : "")">
                                        <img src="@slika.PutanjaDoSlike" class="d-block w-100" alt="Slika vozila" style="height: 300px; object-fit: cover;">
                                        @if (!string.IsNullOrEmpty(slika.Opis))
                                        {
                                            <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-75 rounded">
                                                <p class="mb-0">@slika.Opis</p>
                                            </div>
                                        }
                                    </div>
                                    index++;
                                }
                            </div>
                            <button class="carousel-control-prev" type="button" data-bs-target="#voziloCarousel" data-bs-slide="prev">
                                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Prethodna</span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#voziloCarousel" data-bs-slide="next">
                                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Sledeća</span>
                            </button>
                        </div>

                        <hr />

                        <h6 class="mt-3">Sve Slike (Galerija)</h6>
                        <div class="row">
                            @foreach (var slika in Model.Slike)
                            {
                                <div class="col-6 mb-2">
                                    <a href="@slika.PutanjaDoSlike" target="_blank">
                                        <img src="@slika.PutanjaDoSlike" class="img-thumbnail" style="height: 100px; width: 100%; object-fit: cover;" alt="@slika.Opis" />
                                    </a>
                                    @if (!string.IsNullOrEmpty(slika.Opis))
                                    {
                                        <small class="text-muted d-block">@slika.Opis</small>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center">Nema slika za ovo vozilo.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
            Izmeni
        </a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
            Obriši
        </a>
        <a asp-action="Index" class="btn btn-secondary">
            Nazad na Listu
        </a>
    </div>
</div>