@model Autoskola.DAL.Models.Cas
@using Autoskola.DAL.Models

@{
    ViewData["Title"] = "Obriši Čas";
}

<div class="container mt-4">
    <h1 class="text-danger mb-4">Obriši Čas</h1>
    
    <div class="alert alert-warning" role="alert">
        <i class="bi bi-exclamation-triangle"></i>
        <strong>Upozorenje!</strong> Da li ste sigurni da želite da obrišete ovaj čas?
        @if (Model.KandidatCasovi != null && Model.KandidatCasovi.Any())
        {
            <br />
            <span><strong>Napomena:</strong> Biće obrisano i @Model.KandidatCasovi.Count @(Model.KandidatCasovi.Count == 1 ? "prijava kandidata" : "prijava kandidata") za ovaj čas.</span>
        }
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card mb-3">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">Podaci Časa</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Broj Časa</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-primary fs-6">Čas #@Model.BrojCasa</span>
                        </dd>

                        <dt class="col-sm-4">Tip Časa</dt>
                        <dd class="col-sm-8">
                            @if (Model.TipCasa == TipCasa.Teorijski)
                            {
                                <span class="badge bg-info">
                                    <i class="bi bi-book"></i> Teorijski
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">
                                    <i class="bi bi-car-front"></i> Praktičan
                                </span>
                            }
                        </dd>

                        <dt class="col-sm-4">Datum</dt>
                        <dd class="col-sm-8">
                            @if (Model.Datum.HasValue)
                            {
                                @Model.Datum.Value.ToString("dd.MM.yyyy")
                            }
                            else
                            {
                                <span class="text-muted">Nije zakazan</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Instruktor</dt>
                        <dd class="col-sm-8">
                            @if (Model.Instruktor != null)
                            {
                                <div class="d-flex align-items-center">
                                    @if (!string.IsNullOrEmpty(Model.Instruktor.ProfilnaSlika))
                                    {
                                        <img src="@Model.Instruktor.ProfilnaSlika" alt="@Model.Instruktor.Ime @Model.Instruktor.Prezime" class="rounded me-2" style="width: 40px; height: 40px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="bg-secondary text-white d-flex align-items-center justify-content-center rounded me-2" style="width: 40px; height: 40px; font-size: 14px;">
                                            @(Model.Instruktor.Ime.Substring(0, 1))@(Model.Instruktor.Prezime.Substring(0, 1))
                                        </div>
                                    }
                                    <span>@Model.Instruktor.Ime @Model.Instruktor.Prezime</span>
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </dd>

                        @if (Model.Vozilo != null)
                        {
                            <dt class="col-sm-4">Vozilo</dt>
                            <dd class="col-sm-8">
                                <div class="d-flex align-items-center">
                                    @if (Model.Vozilo.Slike != null && Model.Vozilo.Slike.Any())
                                    {
                                        <img src="@Model.Vozilo.Slike.First().PutanjaDoSlike" alt="@Model.Vozilo.Marka @Model.Vozilo.Model" class="rounded me-2" style="width: 40px; height: 40px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="bg-secondary text-white d-flex align-items-center justify-content-center rounded me-2" style="width: 40px; height: 40px;">
                                            <i class="bi bi-car-front"></i>
                                        </div>
                                    }
                                    <span>@Model.Vozilo.Marka @Model.Vozilo.Model <span class="badge bg-primary">@Model.Vozilo.Registracija</span></span>
                                </div>
                            </dd>
                        }

                        <dt class="col-sm-4">Broj Kandidata</dt>
                        <dd class="col-sm-8">
                            @if (Model.KandidatCasovi != null && Model.KandidatCasovi.Any())
                            {
                                <span class="badge bg-warning text-dark">
                                    <i class="bi bi-people"></i> @Model.KandidatCasovi.Count
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">Nema kandidata</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>

            @if (Model.KandidatCasovi != null && Model.KandidatCasovi.Any())
            {
                <div class="card">
                    <div class="card-header bg-secondary text-white">
                        <h6 class="mb-0">Kandidati na Ovom Času</h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            @foreach (var kandidatCas in Model.KandidatCasovi)
                            {
                                <div class="col-md-6 mb-2">
                                    <div class="d-flex align-items-center">
                                        @if (!string.IsNullOrEmpty(kandidatCas.Kandidat.ProfilnaSlika))
                                        {
                                            <img src="@kandidatCas.Kandidat.ProfilnaSlika" class="rounded me-2" style="width: 30px; height: 30px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="bg-secondary text-white d-flex align-items-center justify-content-center rounded me-2" style="width: 30px; height: 30px; font-size: 12px;">
                                                @(kandidatCas.Kandidat.Ime.Substring(0, 1))@(kandidatCas.Kandidat.Prezime.Substring(0, 1))
                                            </div>
                                        }
                                        <small>@kandidatCas.Kandidat.Ime @kandidatCas.Kandidat.Prezime</small>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="col-md-4">
            <div class="alert alert-danger">
                <h5><i class="bi bi-exclamation-octagon"></i> Kritično!</h5>
                <p class="mb-0">
                    Ova akcija je <strong>nepovratna</strong>. Svi podaci o ovom času će biti trajno obrisani iz sistema.
                </p>
            </div>

            @if (Model.KandidatCasovi != null && Model.KandidatCasovi.Any())
            {
                <div class="card mb-3">
                    <div class="card-header bg-warning">
                        <h6 class="mb-0">Statistika Brisanja</h6>
                    </div>
                    <div class="card-body">
                        <small>
                            <strong>Biće obrisano:</strong><br />
                            - 1 čas<br />
                            - @Model.KandidatCasovi.Count @(Model.KandidatCasovi.Count == 1 ? "prijava" : "prijava") kandidata<br />
                            - Svi povezani podaci
                        </small>
                    </div>
                </div>
            }
        </div>
    </div>

    <form asp-action="Delete" method="post" class="mt-3">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">
            <i class="bi bi-trash"></i> Potvrdi Brisanje
        </button>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Odustani
        </a>
    </form>
</div>