@model IEnumerable<Autoskola.DAL.Models.Cas>
@using Autoskola.DAL.Models

@{
    ViewData["Title"] = "Lista Časova";
}

<div class="container mt-4">
    <h1 class="mb-4">Lista Časova</h1>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Uspeh!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Greška!</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <p>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Dodaj Novi Čas
        </a>
    </p>

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Broj Časa</th>
                <th>Tip Časa</th>
                <th>Datum</th>
                <th>Instruktor</th>
                <th>Vozilo</th>
                <th>Kandidati</th>
                <th>Akcije</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                @foreach (var cas in Model)
                {
                    <tr>
                        <td>
                            <span class="badge bg-primary fs-6">Čas #@cas.BrojCasa</span>
                        </td>
                        <td>
                            @if (cas.TipCasa == TipCasa.Teorijski)
                            {
                                <span class="badge bg-info">
                                    <i class="bi bi-book"></i> Teorijski
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">
                                    <i class="bi bi-car-front"></i> Praktičan
                                </span>
                            }
                        </td>
                        <td>
                            @if (cas.Datum.HasValue)
                            {
                                @cas.Datum.Value.ToString("dd.MM.yyyy")
                            }
                            else
                            {
                                <span class="text-muted">Nije zakazan</span>
                            }
                        </td>
                        <td>
                            @if (cas.Instruktor != null)
                            {
                                <span>@cas.Instruktor.Ime @cas.Instruktor.Prezime</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            @if (cas.Vozilo != null)
                            {
                                <span class="badge bg-secondary">
                                    @cas.Vozilo.Marka @cas.Vozilo.Model
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            @if (cas.KandidatCasovi != null && cas.KandidatCasovi.Any())
                            {
                                <div>
                                    <span class="badge bg-warning text-dark mb-1">
                                        <i class="bi bi-people"></i> @cas.KandidatCasovi.Count
                                    </span>
                                </div>
                                
                                @if (cas.KandidatCasovi.Count <= 3)
                                {
                                    <div>
                                        <small class="text-muted">
                                            @string.Join(", ", cas.KandidatCasovi.Select(kc => $"{kc.Kandidat.Ime} {kc.Kandidat.Prezime}"))
                                        </small>
                                    </div>
                                }
                            }
                            else
                            {
                                <span class="text-muted">Nema kandidata</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@cas.Id" class="btn btn-info btn-sm">
                                Detalji
                            </a>
                            <a asp-action="Edit" asp-route-id="@cas.Id" class="btn btn-warning btn-sm">
                                Izmeni
                            </a>
                            <a asp-action="Delete" asp-route-id="@cas.Id" class="btn btn-danger btn-sm">
                                Obriši
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center">
                        <em>Nema časova u bazi. Kliknite "Dodaj Novi Čas" da dodate prvi.</em>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>