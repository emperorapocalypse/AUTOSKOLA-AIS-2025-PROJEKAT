@model Autoskola.DAL.Models.Ispit
@{
    ViewData["Title"] = "Novi Ispit";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-clipboard-check"></i> Novi Ispit
                    </h4>
                </div>
                <div class="card-body">
                    @if(TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-triangle"></i> @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="Create" method="post">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="TipIspita" class="form-label">
                                    <i class="fas fa-list"></i> Tip Ispita
                                </label>
                                <select asp-for="TipIspita" class="form-select" id="tipIspita" required>
                                    <option value="0">📝 Teorijski</option>
                                    <option value="1">🚗 Praktičan</option>
                                </select>
                                <span asp-validation-for="TipIspita" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Datum" class="form-label">
                                    <i class="fas fa-calendar-alt"></i> Datum
                                </label>
                                <input asp-for="Datum" type="date" class="form-control" required />
                                <span asp-validation-for="Datum" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Bodovi" class="form-label">
                                    <i class="fas fa-star"></i> Bodovi (0-100)
                                </label>
                                <input asp-for="Bodovi" 
                                       type="number" 
                                       min="0" 
                                       max="100" 
                                       class="form-control" 
                                       id="bodoviInput" 
                                       required />
                                <span asp-validation-for="Bodovi" class="text-danger"></span>
                                <div id="statusBadge" class="mt-2"></div>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">
                                    <i class="fas fa-user-graduate"></i> Kandidat
                                </label>
                                <select name="kandidatId" class="form-select" required>
                                    <option value="">-- Izaberi kandidata --</option>
                                    @foreach (var k in ViewBag.Kandidati)
                                    {
                                        <option value="@k.Id">@k.Ime @k.Prezime (@k.JMBG)</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="InstruktorId" class="form-label">
                                <i class="fas fa-chalkboard-teacher"></i> Instruktor
                            </label>
                            <select asp-for="InstruktorId" class="form-select" required>
                                <option value="">-- Izaberi instruktora --</option>
                                @foreach (var i in ViewBag.InstruktoriLista)
                                {
                                    <option value="@i.Id">@i.Ime @i.Prezime</option>
                                }
                            </select>
                            <span asp-validation-for="InstruktorId" class="text-danger"></span>
                        </div>

                        <div id="vozilaSection" class="mb-3" style="display:none;">
                            <label class="form-label">
                                <i class="fas fa-car"></i> Vozila <span class="text-danger">*</span>
                            </label>
                            <div class="alert alert-info small">
                                <i class="fas fa-info-circle"></i> Praktičan ispit mora imati bar jedno vozilo!
                            </div>
                            <div class="row">
                                @foreach (var v in ViewBag.VozilaLista)
                                {
                                    <div class="col-md-6 mb-2">
                                        <div class="card h-100">
                                            <div class="card-body p-2">
                                                <div class="form-check">
                                                    <input class="form-check-input" 
                                                           type="checkbox" 
                                                           name="selectedVozila" 
                                                           value="@v.Id" 
                                                           id="vozilo_@v.Id" />
                                                    <label class="form-check-label" for="vozilo_@v.Id">
                                                        <strong>@v.Marka @v.Model</strong><br />
                                                        <small class="text-muted">
                                                            <i class="fas fa-hashtag"></i> @v.Registracija
                                                        </small>
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <hr />

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save"></i> Sačuvaj
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-times"></i> Otkaži
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleVozila() {
            const tip = document.getElementById('tipIspita').value;
            const vozilaSection = document.getElementById('vozilaSection');
            vozilaSection.style.display = tip === '1' ? 'block' : 'none';
        }

        function updateStatus() {
            const bodovi = parseInt(document.getElementById('bodoviInput').value) || 0;
            const badge = document.getElementById('statusBadge');
            
            if (bodovi >= 51) {
                badge.innerHTML = '<span class="badge bg-success"><i class="fas fa-check"></i> Položen</span>';
            } else {
                badge.innerHTML = '<span class="badge bg-danger"><i class="fas fa-times"></i> Pao</span>';
            }
        }

        document.getElementById('tipIspita').addEventListener('change', toggleVozila);
        document.getElementById('bodoviInput').addEventListener('input', updateStatus);
        
        
        toggleVozila();
        updateStatus();
    </script>
}