@model Autoskola.DAL.Models.Kandidat

@{
    ViewData["Title"] = "Obriši Kandidata";
}

<div class="container mt-4">
    <h1 class="text-danger mb-4">Obriši Kandidata</h1>
    
    <div class="alert alert-warning" role="alert">
        <i class="bi bi-exclamation-triangle"></i>
        <strong>Upozorenje!</strong> Da li ste sigurni da želite da obrišete ovog kandidata?
    </div>

    <div class="card">
        <div class="card-header bg-danger text-white">
            <h5 class="mb-0">Podaci kandidata</h5>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Ime</dt>
                <dd class="col-sm-9">@Model.Ime</dd>

                <dt class="col-sm-3">Prezime</dt>
                <dd class="col-sm-9">@Model.Prezime</dd>

                <dt class="col-sm-3">JMBG</dt>
                <dd class="col-sm-9">@Model.JMBG</dd>

                <dt class="col-sm-3">Telefon</dt>
                <dd class="col-sm-9">@Model.Telefon</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.Email</dd>

                <dt class="col-sm-3">Datum Upisa</dt>
                <dd class="col-sm-9">@Model.DatumUpisa.ToShortDateString()</dd>
            </dl>
        </div>
    </div>

    <form asp-action="Delete" method="post" class="mt-3">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">
            <i class="bi bi-trash"></i> Potvrdi Brisanje
        </button>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Odustani
        </a>
    </form>
</div>